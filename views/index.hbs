<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>journey doc login</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap/dist/css/bootstrap.min.css"
  crossorigin="anonymous"
  referrerpolicy="no-referrer"
  >
  <style>
    body {padding: 50px; display: flex; align-items: center; justify-content: center; height: 100vh;}
    form {width: 500px; margin: 0 auto;}
  </style>
</head>
  <body>
    <form action={{route}} method="post">
      <h2>
        {{title}}
      </h2>
      <div class="form-outline mb-4">
        <input type="text" name="username" id="usernameInput" class="form-control">
        <label for="usernameInput" class="form-label">Username</label>
      </div>
      <div class="form-outline mb-4">
        <input type="password" name="password" id="passwordInput" class="form-control">
        <label for="passwordInput" class="form-label">Password</label>
      </div>
      {{#if showExtraFields}}
       <div class="form-outline mb-4">
        <input type="password" name="confirmPassword" id="confirmPasswordInput" class="form-control">
        <label for="usernameInput" class="form-label">Confirm Password</label>
        {{/if}}
      </div>
      <div class="row mb-4">
        <div class="col">
          {{message}}
          <a href="/?page={{switchPage}}">Click here</a>
        </div>
      </div>
      <button class="btn btn-primary btn-block mb-4">{{title}}</button> 
    </form>
  </body>
</html>