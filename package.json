{
  "name": "app_authentication",
  "version": "1.0.0",
  "description": "user authentication app",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "npm run services:up && npx tsx watch src/server/index.ts",
    "dev:server": "npx tsx watch src/server/index.ts",
    "start:server": "tsx src/server/index.ts",
    "services:up": "docker compose -f src/server/infra/compose.yaml up -d",
    "services:start": "docker compose -f src/server/infra/compose.yaml start",
    "services:down": "docker compose -f src/server/infra/compose.yaml down",
    "setup": "tsx watch src/setup.ts",
    "build": "tsc && vite build",
    "start": "node dist/index.js",
    "lint:prettier:check": "prettier --check .",
    "lint:prettier:write": "prettier --write .",
    "test": "npm run services:up && concurrently -k  --success \"command-JEST\" --names \"DEV,JEST\" \"npm run start:server \" \"node --experimental-vm-modules node_modules/jest/bin/jest.js src --runInBand --verbose\"",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js src --watchAll --runInBand"
  },
  "author": "elber",
  "license": "ISC",
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.4.0",
    "@fastify/formbody": "^9.0.0",
    "@fastify/passport": "^4.0.3",
    "@fastify/session": "^11.1.3",
    "@types/passport-local": "^1.0.38",
    "connect-session-sequelize": "^7.1.7",
    "dotenv": "^18.0.2",
    "fastify": "^5.12.5",
    "jest": "^30.5.2",
    "jsonwebtoken": "^9.0.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "async-retry": "^1.3.3",
    "concurrently": "^9.2.5",
    "cross-env": "^10.1.0",
    "prettier": "^3.9.10",
    "sass": "^1.107.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
